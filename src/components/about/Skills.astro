---
import BadgeList from "@components/common/BadgeList.astro";

type SkillsGroup = {
    title: string;
    skills: string[];
    isFullWidth?: boolean;
}

interface Props {
    groups: SkillsGroup[];
}

const { groups } = Astro.props;

---
<div class="grid items-start gap-x-6 gap-y-3.5 md:grid-cols-[auto_1fr]">
    {groups.map(({title, skills}) => (
        <>
            <p class="text-sm font-medium text-light">{title}</p>
            <BadgeList list={skills} />
        </>
    ))}
</div>
