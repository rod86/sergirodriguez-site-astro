---
import BadgeList from "@components/common/BadgeList.astro";

type SkillsGroup = {
    title: string;
    skills: string[];
}

interface Props {
    groups: SkillsGroup[];
}

const { groups } = Astro.props;

---

{groups.map(({title, skills}) => (
    <div class="grid grid-cols-1 gap-x-8 gap-y-1 sm:grid-cols-[13rem_1fr] my-5">
        <p class="text-sm font-medium text-light leading-relaxed">{title}</p>
        <BadgeList list={skills} />
    </div>
))}


