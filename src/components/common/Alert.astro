---
import type {HTMLAttributes} from "astro/types";
import {Icon} from "astro-icon/components";

interface Props extends HTMLAttributes<"div"> {
    status: "success" | "error";
    class?: string;
}

const { status, class: className, ...rest } = Astro.props;

const iconsMap: Record<Props["status"], string> = {
    success: 'lucide:check',
    error: 'lucide:circle-x',
};

---
<div {...rest} class:list={[
    'flex items-center gap-3 rounded-md border px-4 py-3 text-sm',
    status === 'success' && 'text-success border-success/40 bg-success/10',
    status === 'error' && 'text-danger border-danger/40 bg-danger/10',
    className,
]} role="alert">
    <Icon name={iconsMap[status]} class="h-5 w-5" aria-hidden="true" />
    <slot />
</div>