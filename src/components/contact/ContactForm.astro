---
import Alert from "@components/common/Alert.astro";
import {Icon} from "astro-icon/components";

interface Props {
    className?: string;
}

const { className } = Astro.props;
---

<form
    id="contact-form"
    class:list={[className]}
>
    <Alert id="success-alert" status="success" class="hidden">
        Message sent successfully. I'll get back to you soon.
    </Alert>
    <Alert id="error-alert" status="error" class="hidden">
        <span id="error-message"></span>
    </Alert>

    <div>
        <label for="name" class="form-label">Name</label>
        <input id="name" name="name" type="text" required class="form-input" placeholder="Your name"/>
    </div>
    <div>
        <label for="email" class="form-label">Email</label>
        <input id="email" name="email" type="email" required class="form-input"
            placeholder="you@example.com"/>
    </div>
    <div>
        <label for="message" class="form-label">Message</label>
        <textarea id="message" name="message" rows="4" required class="form-input resize-none"
            placeholder="Tell me about your project…"></textarea>
    </div>
    <div class="hidden">
        <input type="checkbox" name="terms" id="terms" class="form-checkbox" />
        <label for="terms"> I accept the <a href="/privacy">Terms of Service</a></label>
    </div>
    <button id="submit-button" type="submit" class="button mt-2 justify-center px-8 py-4 text-base cursor-pointer">
        <span class="submit-label inline-flex items-center gap-2">
            Send Message
            <Icon name="lucide:arrow-right" class="h-5 w-5"/>
        </span>
        <span class="submit-loading inline-flex items-center gap-2">
            Sending…
            <Icon name="lucide:loader-circle" class="h-5 w-5 animate-spin"/>
        </span>
    </button>
</form>

<script>
    import {sendContactFormMessageHandler} from "@lib/contactForm";

    const form = document.getElementById('contact-form') as HTMLFormElement;
    const submitButton = document.getElementById('submit-button') as HTMLButtonElement;
    const submitLabel = submitButton.querySelector('.submit-label') as HTMLElement;
    const submitLoading = submitButton.querySelector('.submit-loading') as HTMLElement;
    const successAlert = document.getElementById('success-alert') as HTMLElement;
    const errorAlert = document.getElementById('error-alert') as HTMLElement;
    const errorMessage = document.getElementById('error-message') as HTMLElement;

    function setLoading(isLoading: boolean) {
        submitButton.disabled = isLoading;
        submitButton.setAttribute('aria-busy', String(isLoading));
        submitLabel.style.display = isLoading ? 'none' : 'inline-flex';
        submitLoading.style.display = isLoading ? 'inline-flex' : 'none';
    }

    function showAlert(isSuccess: boolean, message?: string) {
        successAlert.classList.toggle('hidden', !isSuccess);
        errorAlert.classList.toggle('hidden', isSuccess);
        if (!isSuccess) {
            errorMessage.textContent = message || 'Something went wrong. Please try again.';
        }
    }

    setLoading(false);

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        setLoading(true);
        successAlert.classList.add('hidden');
        errorAlert.classList.add('hidden');

        try {
            await sendContactFormMessageHandler.invoke({
                name: (form.elements.namedItem('name') as HTMLInputElement).value,
                email: (form.elements.namedItem('email') as HTMLInputElement).value,
                message: (form.elements.namedItem('message') as HTMLInputElement).value,
                terms: (form.elements.namedItem('terms') as HTMLInputElement).checked,
            });
            showAlert(true);
            form.reset();
        } catch (error) {
            showAlert(false, (error as Error).message);
        } finally {
            setLoading(false);
        }
    });
</script>