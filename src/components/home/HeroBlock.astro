---
import heroImg from "@assets/img/coding-agent.svg";
import {Image} from "astro:assets";
import {Icon} from "astro-icon/components";
---

<div class="grid grid-cols-1 items-center gap-14 py-16 lg:grid-cols-2 lg:py-24">
    <!-- left -->
    <div class="text-center lg:text-left">
        <h1 class="text-4xl leading-[1.15] sm:text-4xl lg:whitespace-nowrap lg:text-5xl">
            Software Developer
        </h1>
        <div class="my-4 flex items-center justify-center gap-3 text-sm font-semibold uppercase tracking-[0.22em] text-muted lg:justify-start lg:pl-8">
            <span>NodeJS</span>
            <span class="h-1 w-1 rounded-full bg-primary"></span>
            <span>PHP</span>
            <span class="h-1 w-1 rounded-full bg-primary"></span>
            <span>Python</span>
            <span class="h-1 w-1 rounded-full bg-primary"></span>
            <span>React</span>
        </div>
        <p class="leading-relaxed text-muted lg:max-w-xl">
            With over 20 years of building Full Stack and Backend applications, from MVPs to enterprise platforms.<br/>
            Based in Barcelona. Working with teams worldwide.
        </p>
        <div class="mt-8 flex flex-col items-center gap-5 sm:flex-row sm:justify-center lg:justify-start">
            <a href="/about" class="button w-full sm:w-auto">
                About Me
                <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </a>
            <a href="/portfolio" class="button-outlined bg-background w-full sm:w-auto">
                View Projects
            </a>
        </div>
    </div>
    <!-- right -->
    <div>
        <Image src={heroImg} alt="Full-stack development illustration" class="mx-auto w-full max-w-md" />
    </div>
</div>