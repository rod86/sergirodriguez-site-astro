---
import { Icon } from "astro-icon/components";
import config from "@config";
---

<footer class="border-t border-stroke">
    <div class="page-container flex flex-col items-center justify-between gap-6 py-8 text-sm text-muted md:flex-row md:gap-4">
        <div class="flex items-center gap-8 md:gap-4">
            <a href="/privacy" title="Privacy Policy" aria-label="Privacy" class="grid h-9 w-9 place-items-center text-muted hover:border-primary hover:text-primary-bright">
                <Icon name="lucide:shield" class="h-9 w-9 md:h-7 md:w-7" />
            </a>
            <a href={config.github} title="GitHub" target="_blank" rel="noopener" aria-label="GitHub" class="grid h-9 w-9 place-items-center text-muted hover:border-primary hover:text-primary-bright">
                <Icon name="simple-icons:github" class="h-9 w-9 md:h-7 md:w-7" />
            </a>
            <a href={config.linkedin} title="LinkedIn" target="_blank" rel="noopener" aria-label="LinkedIn" class="grid h-9 w-9 place-items-center text-muted hover:border-primary hover:text-primary-bright">
                <Icon name="simple-icons:linkedin" class="h-9 w-9 md:h-7 md:w-7" />
            </a>
        </div>
        <p>© 2026 Sergi Rodriguez</p>
    </div>
</footer>
