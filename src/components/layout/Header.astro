---
import Image from "astro/components/Image.astro";
import logoImg from "@assets/img/logo.png";
import { Icon } from "astro-icon/components";
import config from '@config';

const { mainNavItems: navLinks} = config;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
    href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 bg-background-alternate/60 backdrop-blur">
    <nav class="page-container flex items-center justify-between py-1.5 md:py-3">
        <a href="/" class="inline-flex items-center" aria-label="Sergi Rodriguez — home">
            <Image src={logoImg} alt="Sergi Rodriguez" class="h-15 w-auto md:h-18" />
        </a>
        <div class="hidden md:flex items-center gap-8">
            {navLinks.map((link) => (
                <a
                    href={link.href}
                    class:list={[
                        'pb-1 border-b-2 duration-300',
                        isActive(link.href)
                            ? 'border-primary text-white'
                            : 'border-transparent text-muted hover:text-white',
                    ]}
                >
                    {link.label}
                </a>
            ))}
        </div>
        <button data-mobile-nav-button class="md:hidden grid h-10 w-10 place-items-center text-light" aria-label="Toggle menu" aria-expanded="false">
            <Icon name="hamburger" class="h-10 w-10" data-icon-open />
            <Icon name="close" class="hidden h-10 w-10" data-icon-close />
        </button>
    </nav>
    <div data-mobile-nav class="hidden md:hidden border-b border-stroke bg-background px-6 py-4">
        <div class="flex flex-col gap-1">
            {navLinks.map((link) => (
                <a
                    href={link.href}
                    class:list={[
                        'rounded-md p-3',
                        isActive(link.href) ? 'text-primary-bright' : 'text-muted hover:bg-surface hover:text-light',
                    ]}
                >
                    {link.label}
                </a>
            ))}
        </div>
    </div>
</header>

<script>
	const mobileButton = document.querySelector('[data-mobile-nav-button]');
	const mobileNav = document.querySelector('[data-mobile-nav]');
	const iconOpen = document.querySelector('[data-icon-open]');
	const iconClose = document.querySelector('[data-icon-close]');

	mobileButton?.addEventListener('click', () => {
	    const isOpen = mobileNav?.classList.toggle('hidden') === false;
	    mobileButton.setAttribute('aria-expanded', String(isOpen));
	    iconOpen?.classList.toggle('hidden', isOpen);
	    iconClose?.classList.toggle('hidden', !isOpen);
	});

	document.querySelectorAll('[data-mobile-nav] a').forEach((a) =>
	    a.addEventListener('click', () => {
	        mobileNav?.classList.add('hidden');
	        mobileButton?.setAttribute('aria-expanded', 'false');
	        iconOpen?.classList.remove('hidden');
	        iconClose?.classList.add('hidden');
	    })
	);
</script>
