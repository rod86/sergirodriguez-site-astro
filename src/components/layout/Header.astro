---
import Image from "astro/components/Image.astro";
import logoImg from "@assets/img/logo.png";

const navLinks = [
	{ href: '/', label: 'Home' },
	{ href: '/portfolio', label: 'Projects' },
	{ href: '/about', label: 'About Me' },
	{ href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 bg-navyalt/60 backdrop-blur">
	<nav class="page-container flex items-center justify-between py-4">
		<a href="/" class="inline-flex items-center" aria-label="Sergi Rodriguez — home">
			<Image src={logoImg} alt="Sergi Rodriguez" class="h-16 w-auto" />
		</a>

		<div class="hidden md:flex items-center gap-8 text-sm">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						'pb-1 border-b-2 duration-300',
						isActive(link.href)
							? 'border-accent text-white'
							: 'border-transparent text-muted hover:text-white',
					]}
				>
					{link.label}
				</a>
			))}
		</div>
		<button data-mobile-nav-button class="md:hidden grid h-10 w-10 place-items-center rounded-md border border-line text-ink" aria-label="Toggle menu" aria-expanded="false">
			<svg data-icon-open viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
			<svg data-icon-close viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="hidden h-5 w-5"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/></svg>
		</button>
	</nav>
	<div data-mobile-nav class="hidden md:hidden border-t border-line bg-navyalt px-6 py-4">
		<div class="flex flex-col gap-1 text-sm">
			{navLinks.map((link) => (
				<a
					href={link.href}
					class:list={[
						'rounded-md px-3 py-2.5',
						isActive(link.href) ? 'text-accentbright' : 'text-muted hover:bg-card hover:text-ink',
					]}
				>
					{link.label}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	const mobileButton = document.querySelector('[data-mobile-nav-button]');
	const mobileNav = document.querySelector('[data-mobile-nav]');
	const iconOpen = document.querySelector('[data-icon-open]');
	const iconClose = document.querySelector('[data-icon-close]');

	mobileButton?.addEventListener('click', () => {
		const isOpen = mobileNav?.classList.toggle('hidden') === false;
		mobileButton.setAttribute('aria-expanded', String(isOpen));
		iconOpen?.classList.toggle('hidden', isOpen);
		iconClose?.classList.toggle('hidden', !isOpen);
	});

	document.querySelectorAll('[data-mobile-nav] a').forEach((a) =>
		a.addEventListener('click', () => {
			mobileNav?.classList.add('hidden');
			mobileButton?.setAttribute('aria-expanded', 'false');
			iconOpen?.classList.remove('hidden');
			iconClose?.classList.add('hidden');
		})
	);
</script>
