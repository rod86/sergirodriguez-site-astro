---
import type {ImageMetadata} from "astro";
import { Icon } from "astro-icon/components";
import {Image} from "astro:assets";

interface Props {
    images: {
        image: ImageMetadata,
        text?: string,
    }[]
}

const { images } = Astro.props;
---

<div class="embla">
    <div class="embla__viewport">
        <div class="embla__container">
            {images.map(img => (
                <div class="embla__slide">
                    <Image src={img.image} alt={img.text ?? ""} />
                </div>
            ))}
        </div>
        <button type="button" aria-label="Previous image" class="embla__previous" disabled>
            <Icon name="lucide:chevron-left" class="h-5 w-5" />
        </button>
        <button type="button" aria-label="Next image" class="embla__next">
            <Icon name="lucide:chevron-right" class="h-5 w-5" />
        </button>
    </div>
    <div class="embla__thumbs">
        <div class="embla-thumbs__viewport">
            <div class="embla-thumbs__container">
                {images.map((img, index) => (
                    <div class:list={["embla-thumbs__slide", index === 0 && "embla-thumbs__slide--selected"]}>
                        <Image src={img.image} alt={img.text ?? ""} />
                    </div>
                ))}
            </div>
        </div>
    </div>
</div>

<script>
    import EmblaCarousel from "embla-carousel";

    const THUMBNAILS_SELECTED_CLASS = "embla-thumbs__slide--selected";

    const initCarousel = (
        mainCarouselElem: HTMLElement,
        thumbsCarouselElem: HTMLElement,
        nextButton: HTMLButtonElement,
        prevButton: HTMLButtonElement,
    ) => {
        const mainCarousel = EmblaCarousel(mainCarouselElem);
        const thumbsCarousel = EmblaCarousel(thumbsCarouselElem, {
            containScroll: 'keepSnaps',
            dragFree: true,
        });

        nextButton.addEventListener("click", () =>  mainCarousel.scrollNext());
        prevButton.addEventListener("click", () => mainCarousel.scrollPrev());

        const slideNodes = thumbsCarousel.slideNodes();
        slideNodes.forEach((slideNode, index) => {
            slideNode.addEventListener("click", () => {
                mainCarousel.scrollTo(index, false);
                slideNodes.forEach(node => node.classList.remove(THUMBNAILS_SELECTED_CLASS));
                slideNode.classList.add(THUMBNAILS_SELECTED_CLASS);
            });
        });

        const totalSlides = mainCarousel.slideNodes().length;
        mainCarousel.on("select", () => {
            const previous = mainCarousel.previousScrollSnap();
            const next = mainCarousel.selectedScrollSnap();
            const slideNodes = thumbsCarousel.slideNodes();
            slideNodes[previous].classList.remove(THUMBNAILS_SELECTED_CLASS);
            slideNodes[next].classList.add(THUMBNAILS_SELECTED_CLASS);
            thumbsCarousel.scrollTo(next);
            prevButton.disabled = next === 0;
            nextButton.disabled = (next+1) === totalSlides
        });
    };

    const mainCarouselElem = document.querySelector(".embla__viewport") as HTMLElement;
    const thumbCarouselElem = document.querySelector(".embla-thumbs__viewport") as HTMLElement;
    const prevButton = document.querySelector('.embla__previous') as HTMLButtonElement;
    const nextButton = document.querySelector('.embla__next') as HTMLButtonElement;
    initCarousel(mainCarouselElem, thumbCarouselElem, nextButton, prevButton);
</script>