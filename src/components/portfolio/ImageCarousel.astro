---
import type {ImageMetadata} from "astro";
import {Image} from "astro:assets";

interface Props {
    images: {
        image: ImageMetadata,
        text?: string,
    }[]
}

const { images } = Astro.props;
---

<div class="embla">
    <div class="embla__viewport">
        <div class="embla__container">
            {images.map(img => (
                <div class="embla__slide">
                    <Image src={img.image} alt={img.text ?? ""} />
                </div>
            ))}

        </div>
    </div>
    <div class="embla__thumbs">
        <div class="embla-thumbs__viewport">
            <div class="embla-thumbs__container">
                {images.map((img, index) => (
                    <div class:list={["embla-thumbs__slide", index === 0 && "embla-thumbs__slide--selected"]}>
                        <Image src={img.image} alt={img.text ?? ""} />
                    </div>
                ))}
            </div>
        </div>
    </div>
</div>

<script>
    import EmblaCarousel from "embla-carousel";

    const mainCarouselElem = document.querySelector(".embla__viewport") as HTMLElement;
    const thumbCarouselElem = document.querySelector(".embla-thumbs__viewport") as HTMLElement;
    EmblaCarousel(mainCarouselElem);
    EmblaCarousel(thumbCarouselElem, {
        containScroll: 'keepSnaps',
        dragFree: true,
    });
</script>