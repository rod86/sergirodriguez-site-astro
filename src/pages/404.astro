---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Page Not Found" description="Page Not Found">
    <section>
        <h1>Page Not Found</h1>
        <div class="text-content">
            <p class="mt-10">
                Oops, we can't find that page. It may have been moved or deleted.
            </p>
            <p class="mt-5">
                Go to <a href="/">Home Page</a>
            </p>
        </div>
    </section>
</Layout>