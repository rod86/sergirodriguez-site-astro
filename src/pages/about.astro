---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import aboutImg from '@assets/img/laptop-photo.jpg';
import {Icon} from "astro-icon/components";
import config from '@config';
import Skills from "@components/about/Skills.astro";
import WorkExperience from "@components/about/WorkExperience.astro";
---

<Layout title="About Me" description="About Sergi Rodriguez, Full Stack Developer with 10+ years of experience.">
    <section>
        <div class="grid grid-cols-1 gap-14 lg:grid-cols-[1.15fr_0.85fr]">
			<!-- LEFT: text + skills -->
			<div>
			    <h1 class="mb-6">About Me</h1>
			    <div class="space-y-4 text-[15px] leading-relaxed text-muted">
			        <p>
						I am Sergi Rodriguez, a software developer specialised in <strong>Node.js</strong>, <strong>PHP</strong>, <strong>Python</strong> and <strong>React</strong>.
						I build full stack applications, from REST APIs and automated processes to frontend dashboards.
			        </p>
			        <p>
						I have studied <strong>Networking and Applications Development</strong> in <strong>Barcelona</strong> where I was introduced to programming languages like <strong>Basic.NET</strong>, <strong>C#.NET</strong>, <strong>ASP 3.0</strong> and <strong>PHP</strong>.
			        </p>
			        <p>
						I started my career in Barcelona working with <strong>PHP</strong> and <strong>MySQL</strong> in several companies, most of them digital agencies.
						Five years later, I moved to London, where I grew my skills at different companies including digital agencies, internal marketing tools and a charity platform.
						After another 5 years, I returned to Barcelona, where I continued building internal products and REST APIs.
			        </p>
			        <p>
						I am a self-motivated hard worker with a "can do" attitude and a good team player.
						I keep myself updated with the latest trends through books and courses, and I enjoy sharing knowledge and mentoring teammates.
						Through my experience in many companies, I have learned different ways to work and adapt to different types and sizes of teams.
			        </p>
			    </div>
			    <div class="mt-10">
				    <h2 class="mb-6">Skills &amp; Tools</h2>
			        <Skills groups={config.skillsGroups} />
			    </div>
			    <div class="mt-10">
			        <h2 class="mb-6">Experience</h2>
			        <WorkExperience workExperiences={config.workExperiences} />
			    </div>
			</div>

			<!-- RIGHT: image -->
			<div>
			    <div class="aspect-4/5 overflow-hidden rounded-2xl border border-stroke md:w-90 md:mx-auto lg:w-full lg:mx-0">
					<!-- Photo by AltumCode on Unsplash (https://unsplash.com/@altumcode) -->
					<Image src={aboutImg} alt="Portrait of Sergi Rodriguez" class="h-full w-full object-cover" />
			    </div>
			    <a href="/contact" class="button mt-6 flex justify-center md:w-90 md:mx-auto lg:w-full lg:mx-0">
					Get in touch
			        <Icon name="lucide:arrow-right" class="h-4 w-4" />
			    </a>
			</div>
        </div>
    </section>
</Layout>
