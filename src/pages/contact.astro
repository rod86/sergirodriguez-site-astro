---
import Layout from '@layouts/Layout.astro';
import SocialLink from "@components/contact/SocialLink.astro";
import ContactForm from "@components/contact/ContactForm.astro";
---

<Layout title="Contact" description="Get in touch with Sergi Rodriguez, Full Stack Developer.">
    <section class="py-20 lg:py-28">
        <div class="text-center">
            <h1>Let's build something.</h1>
            <p class="mx-auto mt-5 max-w-xl text-[15px] leading-relaxed text-muted">
                I'm always open to discussing new projects, freelance work, or opportunities to collaborate.
                Reach out via LinkedIn, GitHub, or the form.
            </p>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2">
            <div class="flex flex-col gap-5">
                <SocialLink label="LinkedIn" href="https://linkedin.com/in/sergirodriguez" displayUrl="linkedin.com/in/sergirodriguez" icon="simple-icons:linkedin" />
                <SocialLink label="GitHub" href="https://github.com/sergirodriguez" displayUrl="github.com/sergirodriguez" icon="simple-icons:github" />
            </div>
            <ContactForm className="flex flex-col gap-6" />
        </div>
    </section>
</Layout>
