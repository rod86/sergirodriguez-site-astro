---
import Layout from '@layouts/Layout.astro';
---

<Layout title="Contact" description="Get in touch with Sergi Rodriguez, Full Stack Developer.">
	<section>
		<div class="page-container py-20 lg:py-28">
			<div class="text-center">
				<h1>Let's build something.</h1>
				<p class="mx-auto mt-5 max-w-xl text-[15px] leading-relaxed text-muted">
					I'm always open to discussing new projects, freelance work, or opportunities to collaborate.
					Reach out via LinkedIn, GitHub, or the form.
				</p>
			</div>

			<div class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2">
				<div class="flex flex-col gap-5">
					<a href="https://linkedin.com/in/sergirodriguez" target="_blank" rel="noopener"
					   class="group flex items-center gap-4 rounded-xl border border-line bg-card p-6 text-ink hover:border-accent/60">
						<span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-navyalt text-accent-muted">
							<svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
						</span>
						<div class="min-w-0">
							<p class="font-semibold">LinkedIn</p>
							<p class="truncate text-sm text-muted">linkedin.com/in/sergirodriguez</p>
						</div>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-auto h-5 w-5 shrink-0 text-muted transition-colors group-hover:text-accentbright"><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>

					<a href="https://github.com/sergirodriguez" target="_blank" rel="noopener"
					   class="group flex items-center gap-4 rounded-xl border border-line bg-card p-6 text-ink hover:border-accent/60">
						<span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-navyalt text-accent-muted">
							<svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22 0 1.6-.02 2.89-.02 3.29 0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>
						</span>
						<div class="min-w-0">
							<p class="font-semibold">GitHub</p>
							<p class="truncate text-sm text-muted">github.com/sergirodriguez</p>
						</div>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-auto h-5 w-5 shrink-0 text-muted transition-colors group-hover:text-accentbright"><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
				</div>

				<form class="flex flex-col gap-6" id="contact-form">
					<div data-form-success class="items-center gap-3 rounded-md border border-success/40 bg-success/10 px-4 py-3 text-sm text-success">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 shrink-0"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
						Message sent successfully. I'll get back to you soon.
					</div>
					<div data-form-error class="items-center gap-3 rounded-md border border-danger/40 bg-danger/10 px-4 py-3 text-sm text-danger">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5 shrink-0"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01" stroke-linecap="round"/></svg>
						Something went wrong. Please try again.
					</div>
					<div>
						<label for="name" class="form-label">Name</label>
						<input id="name" name="name" type="text" required class="form-input" placeholder="Your name" />
					</div>
					<div>
						<label for="email" class="form-label">Email</label>
						<input id="email" name="email" type="email" required class="form-input" placeholder="you@example.com" />
					</div>
					<div>
						<label for="message" class="form-label">Message</label>
						<textarea id="message" name="message" rows="4" required class="form-input resize-none" placeholder="Tell me about your project…"></textarea>
					</div>
					<button type="submit" class="mt-2 inline-flex items-center justify-center gap-2 rounded-md bg-accent px-8 py-4 text-base font-semibold text-navy transition-colors hover:bg-accentbright">
						Send Message
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</button>
				</form>
			</div>
		</div>
	</section>
</Layout>
