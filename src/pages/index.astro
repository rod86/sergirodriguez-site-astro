---
import Layout from '@layouts/Layout.astro';
import { projectsContentProvider } from "@lib/projects";
import HeroBlock from "@components/home/HeroBlock.astro";
import BentoGrid from "@components/home/BentoGrid.astro";
import { Icon } from 'astro-icon/components';
import config from "@config";

const projects = await projectsContentProvider.getFeaturedProjects(config.featuredProjects);
---

<Layout>
    <section>
	    <HeroBlock />
    </section>
    <section>
        <h2 class="text-3xl mb-12 sm:text-4xl">Featured Projects</h2>
        <BentoGrid projects={projects} />
        <a href="/portfolio" class="link-arrow-right mt-10">
			All projects
            <Icon name="lucide:arrow-right" class="link-arrow-icon" />
        </a>
    </section>
</Layout>
