---
import Layout from '@layouts/Layout.astro';
import {getFeaturedProjects} from "@lib/projects/astroCollection.ts";
import HeroBlock from "@components/home/HeroBlock.astro";
import BentoGrid from "@components/home/BentoGrid.astro";

const homeProjects = [
    'ai-prompts-vault-api',
    'learning-hub',
    'symfony-auctions-api',
    'lunchbox',
];
const projects = await getFeaturedProjects(homeProjects);
---

<Layout>
	<!-- ===== HERO ===== -->
	<section>
	    <HeroBlock />
	</section>

	<!-- ===== FEATURED PROJECTS ===== -->
	<section>
	    <div class="page-container pt-4 pb-20 lg:pt-6 lg:pb-24">
	        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
	            <h2 class="text-3xl sm:text-4xl">Featured Projects</h2>
	            <a href="/portfolio" class="inline-flex items-center gap-2 text-sm font-semibold">
					All projects
	                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
	            </a>
	        </div>

	        <BentoGrid projects={projects} />
	    </div>
	</section>
</Layout>
