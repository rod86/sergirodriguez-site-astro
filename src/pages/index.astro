---
import Layout from '@layouts/Layout.astro';
import {getFeaturedProjects} from "@lib/projects/astroCollection.ts";
import HeroBlock from "@components/home/HeroBlock.astro";
import BentoGrid from "@components/home/BentoGrid.astro";
import { Icon } from 'astro-icon/components';

const homeProjects = [
    'ai-prompts-vault-api',
    'learning-hub',
    'symfony-auctions-api',
    'lunchbox',
];
const projects = await getFeaturedProjects(homeProjects);
---

<Layout>
    <section>
	    <HeroBlock />
    </section>
    <section>
        <h2 class="text-3xl mb-12 sm:text-4xl">Featured Projects</h2>
        <BentoGrid projects={projects} />
        <a href="/portfolio" class="mt-10 flex w-fit justify-center mx-auto items-center gap-2 font-semibold text-primary transition-colors md:mx-0 md:ml-auto md:text-sm hover:text-white">
			All projects
            <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
    </section>
</Layout>
