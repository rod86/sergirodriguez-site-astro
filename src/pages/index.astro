---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImg from '@assets/img/coding-agent.svg';
import projectImg from '@assets/img/home.png';
---

<Layout>
	<!-- ===== HERO ===== -->
	<section class="relative overflow-hidden">
		<div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 px-6 py-20 lg:grid-cols-2 lg:py-28">
			<!-- left -->
			<div>
				<h1 class="text-2xl font-semibold leading-[1.15] tracking-tight whitespace-nowrap sm:text-4xl sm:whitespace-normal lg:text-6xl" style="font-size: 48px; font-weight: 600">
					Full Stack Developer
				</h1>
				<p class="mt-6 max-w-xl text-[15px] leading-relaxed text-muted">
					With over 10 years of experience building with PHP, Node.js, TypeScript, Python and React,
					I craft scalable, high-performance web applications — from MVPs to enterprise-grade platforms.
					I care deeply about clean code, thoughtful architecture, and shipping things that last.
				</p>
				<div class="mt-8 flex flex-wrap gap-3">
					<a href="/about" class="inline-flex items-center gap-2 rounded-md bg-accent px-5 py-3 text-sm font-semibold text-navy hover:bg-accentbright transition-colors">
						About Me
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
					</a>
					<a href="/portfolio" class="inline-flex items-center gap-2 rounded-md border border-line bg-navyalt px-5 py-3 text-sm font-semibold text-ink hover:border-accent transition-colors">
						View Projects
					</a>
				</div>
			</div>
			<!-- right: hero image -->
			<div>
				<Image src={heroImg} alt="Full-stack development illustration" class="mx-auto w-full max-w-md" />
			</div>
		</div>
	</section>

	<!-- ===== FEATURED PROJECTS ===== -->
	<section>
		<div class="mx-auto max-w-6xl px-6 pt-4 pb-20 lg:pt-6 lg:pb-24">
			<div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
				<h2 class="text-3xl font-medium tracking-tight sm:text-4xl">Featured Projects</h2>
				<a href="/portfolio" class="inline-flex items-center gap-2 text-sm font-semibold text-accentbright hover:text-ink transition-colors">
					All projects
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</a>
			</div>

			<div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3 lg:grid-rows-2">
				<a href="/portfolio" class="group relative flex flex-col justify-end overflow-hidden rounded-xl border border-line bg-card lg:row-span-2">
					<Image src={projectImg} alt="Streamline screenshot" class="absolute inset-0 h-full w-full object-cover opacity-30 transition-opacity duration-300 group-hover:opacity-45" />
					<div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/75 to-navy/25"></div>
					<div class="relative p-7">
						<p class="font-mono text-xs text-[#64748b]">January 2024</p>
						<p class="mt-0.5 text-xs text-[#64748b]">Working at DataForge</p>
						<h3 class="mt-2 text-2xl font-medium tracking-tight">Streamline</h3>
						<p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">Real-time analytics pipeline processing millions of events daily.</p>
						<div class="mt-4 flex flex-wrap gap-2">
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">TypeScript</span>
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">Next.js</span>
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">GraphQL</span>
						</div>
						<span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-accentbright transition-colors group-hover:text-ink">
							View Project
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</span>
					</div>
				</a>

				<a href="/portfolio" class="group relative flex flex-col justify-center overflow-hidden rounded-xl border border-line bg-card p-7 transition-colors hover:border-accent/60">
					<Image src={projectImg} alt="MediTrack screenshot" class="absolute inset-0 h-full w-full object-cover opacity-25 transition-opacity duration-300 group-hover:opacity-40" />
					<div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/80 to-navy/40"></div>
					<div class="relative">
						<p class="font-mono text-xs text-[#64748b]">September 2022</p>
						<p class="mt-0.5 text-xs text-[#64748b]">Working at Helix Health</p>
						<h3 class="mt-2 text-xl font-medium tracking-tight">MediTrack</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted">HIPAA-compliant patient monitoring for thousands of clinicians.</p>
						<div class="mt-3 flex flex-wrap gap-2">
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">Python</span>
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">Django</span>
						</div>
						<span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accentbright transition-colors group-hover:text-ink">
							View Project
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</span>
					</div>
				</a>

				<a href="/portfolio" class="group relative flex flex-col justify-center overflow-hidden rounded-xl border border-line bg-card p-7 transition-colors hover:border-accent/60">
					<Image src={projectImg} alt="ShipFast screenshot" class="absolute inset-0 h-full w-full object-cover opacity-25 transition-opacity duration-300 group-hover:opacity-40" />
					<div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/80 to-navy/40"></div>
					<div class="relative">
						<p class="font-mono text-xs text-[#64748b]">March 2021</p>
						<p class="mt-0.5 text-xs text-[#64748b]">Working at Nomad Logistics</p>
						<h3 class="mt-2 text-xl font-medium tracking-tight">ShipFast</h3>
						<p class="mt-2 text-sm leading-relaxed text-muted">Route-optimization engine that cut delivery times by 22%.</p>
						<div class="mt-3 flex flex-wrap gap-2">
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">Node.js</span>
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">React</span>
						</div>
						<span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accentbright transition-colors group-hover:text-ink">
							View Project
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</span>
					</div>
				</a>

				<a href="/portfolio" class="group relative flex flex-col justify-center overflow-hidden rounded-xl border border-line bg-card p-7 transition-colors hover:border-accent/60 sm:col-span-2 lg:col-span-2">
					<Image src={projectImg} alt="Ledgerly screenshot" class="absolute inset-0 h-full w-full object-cover opacity-25 transition-opacity duration-300 group-hover:opacity-40" />
					<div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/80 to-navy/40"></div>
					<div class="relative">
						<p class="font-mono text-xs text-[#64748b]">May 2019</p>
						<p class="mt-0.5 text-xs text-[#64748b]">Working at FinCore Systems</p>
						<h3 class="mt-2 text-xl font-medium tracking-tight">Ledgerly</h3>
						<p class="mt-2 max-w-lg text-sm leading-relaxed text-muted">Double-entry accounting platform with automated reconciliation.</p>
						<div class="mt-3 flex flex-wrap gap-2">
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">PHP</span>
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">Laravel</span>
							<span class="rounded border border-accent px-2 py-1 font-mono text-[11px] text-accent">Vue</span>
						</div>
						<span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accentbright transition-colors group-hover:text-ink">
							View Project
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</span>
					</div>
				</a>
			</div>
		</div>
	</section>
</Layout>
