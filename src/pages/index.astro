---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImg from '@assets/img/coding-agent.svg';
import {getFeaturedProjects} from "@lib/projects/astroCollection.ts";

const homeProjects = [
    'ai-prompts-vault-api',
    'learning-hub',
    'symfony-auctions-api',
    'lunchbox',
];
const [project1, project2, project3, project4] = await getFeaturedProjects(homeProjects);
---

<Layout>
	<!-- ===== HERO ===== -->
	<section class="relative overflow-hidden">
	    <div class="page-container grid grid-cols-1 items-center gap-14 py-20 lg:grid-cols-2 lg:py-28">
			<!-- left -->
			<div>
			    <h1 class="text-2xl leading-[1.15] whitespace-nowrap sm:text-4xl sm:whitespace-normal lg:text-6xl" style="font-size: 48px; font-weight: 600">
					Full Stack Developer
			    </h1>
			    <p class="mt-6 max-w-xl text-[15px] leading-relaxed text-muted">
					With over 10 years of experience building with PHP, Node.js, TypeScript, Python and React,
					I craft scalable, high-performance web applications — from MVPs to enterprise-grade platforms.
					I care deeply about clean code, thoughtful architecture, and shipping things that last.
			    </p>
			    <div class="mt-8 flex flex-wrap gap-3">
			        <a href="/about" class="button">
						About Me
			            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
			        </a>
			        <a href="/portfolio" class="button-outlined bg-background">
						View Projects
			        </a>
			    </div>
			</div>
			<!-- right: hero image -->
			<div>
			    <Image src={heroImg} alt="Full-stack development illustration" class="mx-auto w-full max-w-md" />
			</div>
	    </div>
	</section>

	<!-- ===== FEATURED PROJECTS ===== -->
	<section>
	    <div class="page-container pt-4 pb-20 lg:pt-6 lg:pb-24">
	        <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
	            <h2 class="text-3xl sm:text-4xl">Featured Projects</h2>
	            <a href="/portfolio" class="inline-flex items-center gap-2 text-sm font-semibold">
					All projects
	                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
	            </a>
	        </div>

	        <div class="bento-grid mt-12">
	            <a href={`/portfolio/${project1.id}`} class="group bento-grid-item bento-grid-item-1">
	                {project1.image && (
	                    <Image src={project1.image} alt={`${project1.title} thumbnail`} class="bento-grid-item-image opacity-30 group-hover:opacity-45" />
	                )}
	                <div class="bento-grid-item-overlay"></div>
	                <div class="bento-grid-item-content">
	                    <p class="bento-grid-item-date">
	                        {project1.date}
	                    </p>
	                    <p class="bento-grid-item-company">
	                        {project1.company && `Working at ${project1.company}`}
	                    </p>
	                    <h3 class="bento-grid-item-title text-2xl">
	                        {project1.title}
	                    </h3>
	                    <p class="bento-grid-item-description max-w-sm mb-4">
							{project1.shortDescription}
	                    </p>
	                    <div class="bento-grid-item-tags badge-list mb-5">
	                        {project1.tags.map((tag: string) => (
	                            <span class="badge">{tag}</span>
	                        ))}
	                    </div>
	                    <span class="bento-grid-item-cta">
							View Project
	                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
	                    </span>
	                </div>
	            </a>

	            <a href={`/portfolio/${project2.id}`} class="group bento-grid-item bento-grid-item-2">
	                {project2.image && (
	                    <Image src={project2.image} alt={`${project2.title} thumbnail`} class="bento-grid-item-image" />
	                )}
	                <div class="bento-grid-item-overlay"></div>
	                <div class="bento-grid-item-content">
	                    <p class="bento-grid-item-date">
	                        {project2.date}
	                    </p>
	                    <p class="bento-grid-item-company">
	                        {project2.company && `Working at ${project2.company}`}
	                    </p>
	                    <h3 class="bento-grid-item-title">
	                        {project2.title}
	                    </h3>
	                    <p class="bento-grid-item-description">
							{project2.shortDescription}
	                    </p>
	                    <div class="bento-grid-item-tags badge-list">
	                        {project2.tags.map((tag: string) => (
	                            <span class="badge">{tag}</span>
	                        ))}
	                    </div>
	                    <span class="bento-grid-item-cta">
							View Project
	                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
	                    </span>
	                </div>
	            </a>

	            <a href={`/portfolio/${project3.id}`} class="group bento-grid-item bento-grid-item-3">
	                {project3.image && (
	                    <Image src={project3.image} alt={`${project3.title} thumbnail`} class="bento-grid-item-image" />
	                )}
	                <div class="bento-grid-item-overlay"></div>
	                <div class="bento-grid-item-content">
	                    <p class="bento-grid-item-date">
	                        {project3.date}
	                    </p>
	                    <p class="bento-grid-item-company">
	                        {project3.company && `Working at ${project3.company}`}
	                    </p>
	                    <h3 class="bento-grid-item-title">
	                        {project3.title}
	                    </h3>
	                    <p class="bento-grid-item-description">
							{project3.shortDescription}
	                    </p>
	                    <div class="bento-grid-item-tags badge-list">
	                        {project3.tags.map((tag: string) => (
	                            <span class="badge">{tag}</span>
	                        ))}
	                    </div>
	                    <span class="bento-grid-item-cta">
							View Project
	                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
	                    </span>
	                </div>
	            </a>

	            <a href={`/portfolio/${project4.id}`} class="group bento-grid-item bento-grid-item-4">
	                {project4.image && (
	                    <Image src={project4.image} alt={`${project4.title} thumbnail`} class="bento-grid-item-image" />
	                )}
	                <div class="bento-grid-item-overlay"></div>
	                <div class="bento-grid-item-content">
	                    <p class="bento-grid-item-date">
	                        {project4.date}
	                    </p>
	                    <p class="bento-grid-item-company">
	                        {project4.company && `Working at ${project4.company}`}
	                    </p>
	                    <h3 class="bento-grid-item-title">
	                        {project4.title}
	                    </h3>
	                    <p class="bento-grid-item-description max-w-lg">
							{project4.shortDescription}
	                    </p>
	                    <div class="bento-grid-item-tags badge-list">
	                        {project4.tags.map((tag: string) => (
	                            <span class="badge">{tag}</span>
	                        ))}
	                    </div>
	                    <span class="bento-grid-item-cta">
							View Project
	                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
	                    </span>
	                </div>
	            </a>
	        </div>
	    </div>
	</section>
</Layout>
