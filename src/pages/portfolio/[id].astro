---
import Layout from '@layouts/Layout.astro';
import {Image} from 'astro:assets';
import { projectsContentProvider } from "@lib/projects";
import {Icon} from "astro-icon/components";
import BadgeList from "@components/common/BadgeList.astro";
import ImageCarousel from "@components/portfolio/ImageCarousel.astro";

export async function getStaticPaths() {
    const projects = await projectsContentProvider.getProjects();
    return projects.map((entry) => ({
        params: {id: entry.id},
        props: {entry},
    }));
}

const {id} = Astro.params;
const {
    title,
    date,
    company,
    tags,
    github_url,
    url,
    Content,
    images
} = await projectsContentProvider.getProjectDetails(id);
---

<Layout title={title} description={`${title} — a project by Sergi Rodriguez, Full Stack Developer.`}>
    <section>
        <a href="/portfolio" class="link-arrow-left">
            <Icon name="lucide:arrow-left" class="link-arrow-icon" />
            Back to projects
        </a>

        <div class="mt-10 grid grid-cols-1 items-stretch gap-12 lg:grid-cols-2">
            <!-- LEFT: info -->
            <div class="flex flex-col">
                <p class="text-sm text-muted">{date}</p>
                <h1 class="mt-3">{title}</h1>
                {company && <p class="mt-3 text-[15px] text-muted">Working at {company}</p>}

                {tags.length > 0 && (
                    <BadgeList list={tags} className="mt-6" />
                )}

                <div class="mt-8 space-y-4 text-[15px] leading-relaxed text-muted">
                    <Content />
                </div>
            </div>

            <!-- RIGHT: image -->
            {(images && images.length > 1) && (
                <div class="flex w-113.25 max-w-full mx-auto lg:my-auto">
                    <ImageCarousel images={images} />
                </div>
            )}
            {(images && images.length === 1) && (
                <div class="flex w-113.25 max-w-full items-center justify-center mx-auto overflow-hidden rounded-2xl border border-stroke lg:my-auto">
                    <Image src={images[0].image} alt={images[0].text ?? title} class="h-68.5 w-full object-cover"/>
                </div>
            )}
        </div>

        {(url || github_url) && (
            <div class="flex flex-col flex-wrap mx-auto justify-center gap-5 mt-12 lg:flex-row">
                {url && (
                    <a href={url} target="_blank" rel="noopener" class="button">
                        <Icon name="lucide:external-link" class="h-4 w-4" />
                        Live Demo
                    </a>
                )}
                {github_url && (
                    <a href={github_url} target="_blank" rel="noopener" class="button-outlined">
                        <Icon name="simple-icons:github" class="h-4 w-4" />
                        Source Code
                    </a>
                )}
            </div>
        )}
    </section>
</Layout>
