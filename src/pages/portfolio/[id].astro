---
import Layout from '@layouts/Layout.astro';
import {Image} from 'astro:assets';
import {getProjectDetails, getProjectsList} from "@lib/projects/astroCollection.ts";
import {Icon} from "astro-icon/components";

export async function getStaticPaths() {
    const projects = await getProjectsList();
    return projects.map((entry) => ({
        params: {id: entry.id},
        props: {entry},
    }));
}

const {id} = Astro.params;
const {
    title,
    date,
    company,
    tags,
    github_url,
    url,
    Content,
    image
} = await getProjectDetails(id);
---

<Layout title={title} description={`${title} — a project by Sergi Rodriguez, Full Stack Developer.`}>
    <section>
        <a href="/portfolio" class="link-arrow-left">
            <Icon name="lucide:arrow-left" class="link-arrow-icon" />
            Back to projects
        </a>

        <div class="mt-10 grid grid-cols-1 items-stretch gap-12 lg:grid-cols-2">
            <!-- LEFT: info -->
            <div class="flex flex-col">
                <p class="text-sm text-muted">{date}</p>
                <h1 class="mt-3">{title}</h1>
                {company && <p class="mt-3 text-[15px] text-muted">Working at {company}</p>}

                {tags.length > 0 && (
                    <div class="mt-6 badge-list">
                        {tags.map((tag) => (
                            <span class="badge px-2.5 text-xs">{tag}</span>
                        ))}
                    </div>
                )}

                <div class="mt-8 space-y-4 text-[15px] leading-relaxed text-muted">
                    <Content />
                </div>
            </div>

            <!-- RIGHT: image -->
            {image && (
                <div class="flex w-113.25 max-w-full items-center justify-center mx-auto overflow-hidden rounded-2xl border border-stroke lg:my-auto">
                    <Image src={image} alt={`${title} — dashboard screenshot`} class="h-68.5 w-full object-cover"/>
                </div>
            )}
        </div>

        {(url || github_url) && (
            <div class="flex flex-col flex-wrap mx-auto justify-center gap-5 mt-12 lg:flex-row">
                {url && (
                    <a href={url} target="_blank" rel="noopener" class="button">
                        <Icon name="lucide:external-link" class="h-4 w-4" />
                        View Project
                    </a>
                )}
                {github_url && (
                    <a href={github_url} target="_blank" rel="noopener" class="button-outlined">
                        <Icon name="simple-icons:github" class="h-4 w-4" />
                        GitHub Repository
                    </a>
                )}
            </div>
        )}
    </section>
</Layout>
