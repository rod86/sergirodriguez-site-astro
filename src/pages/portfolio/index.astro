---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import projectImg from '@assets/img/home.png';

const projects = [
	{
		title: 'Ledgerly',
		date: 'May 2019',
		company: 'Working at FinCore Systems',
		description: 'Double-entry accounting platform with automated reconciliation and real-time financial reporting for growing businesses.',
		tags: ['PHP', 'Laravel', 'MySQL', 'Vue'],
	},
	{
		title: 'ShipFast',
		date: 'March 2021',
		company: 'Working at Nomad Logistics',
		description: 'Route-optimization engine and driver app that cut delivery times by 22% across a national fleet.',
		tags: ['Node.js', 'TypeScript', 'PostgreSQL', 'React'],
	},
	{
		title: 'MediTrack',
		date: 'September 2022',
		company: 'Working at Helix Health',
		description: 'HIPAA-compliant patient monitoring platform serving thousands of clinicians daily.',
		tags: ['Python', 'Django', 'React', 'AWS'],
	},
	{
		title: 'Streamline',
		date: 'January 2024',
		company: 'Working at DataForge',
		description: 'Real-time analytics pipeline processing millions of events daily with a sub-second query layer.',
		tags: ['TypeScript', 'Next.js', 'GraphQL', 'Redis'],
	},
	{
		title: 'Nimbus CRM',
		date: 'November 2018',
		company: 'Working at Vertex Solutions',
		description: 'Multi-tenant CRM with pipeline automation, custom reporting, and a flexible permissions model.',
		tags: ['PHP', 'Symfony', 'PostgreSQL', 'Vue'],
	},
	{
		title: 'Pulseboard',
		date: 'June 2020',
		company: 'Working at Arclight Media',
		description: 'Live social-media dashboard aggregating engagement metrics across a dozen platforms in real time.',
		tags: ['Node.js', 'Express', 'MongoDB', 'React'],
	},
	{
		title: 'Fleetly',
		date: 'February 2023',
		company: 'Working at Convoy Freight',
		description: 'Vehicle telemetry and maintenance-scheduling system for a mixed commercial fleet.',
		tags: ['Python', 'FastAPI', 'PostgreSQL', 'React'],
	},
	{
		title: 'Inkwell',
		date: 'August 2021',
		company: null,
		description: 'A distraction-free markdown writing app with live preview, sync, and publishing — a personal side project.',
		tags: ['TypeScript', 'Next.js', 'Prisma', 'Tailwind'],
	},
	{
		title: 'Vaultify',
		date: 'October 2019',
		company: 'Working at Northgate Bank',
		description: 'Secure document vault with granular access control and full audit logging for a regional bank.',
		tags: ['PHP', 'Laravel', 'MySQL', 'Redis'],
	},
	{
		title: 'Beacon Analytics',
		date: 'April 2024',
		company: null,
		description: 'Self-hosted, privacy-first web analytics with a columnar backend — an open-source side project.',
		tags: ['TypeScript', 'GraphQL', 'ClickHouse', 'React'],
	},
	{
		title: 'Orbitmail',
		date: 'December 2020',
		company: 'Working at Skyline Comms',
		description: 'Transactional email delivery service with templating, scheduling, and deliverability analytics.',
		tags: ['Node.js', 'NestJS', 'PostgreSQL', 'Redis'],
	},
	{
		title: 'Craftly',
		date: 'July 2022',
		company: null,
		description: 'Marketplace for handmade goods with integrated payments and seller storefronts — a personal project.',
		tags: ['Python', 'Django', 'PostgreSQL', 'Vue'],
	},
];
---

<Layout title="Projects" description="Selected projects by Sergi Rodriguez, Full Stack Developer.">
	<!-- ===== PAGE HEADER ===== -->
	<section>
		<div class="page-container pt-10 pb-4 lg:pt-14 lg:pb-6">
			<h1>Projects</h1>
		</div>
	</section>

	<!-- ===== FEATURE ROWS ===== -->
	<section>
		<div class="page-container pt-6 pb-16 lg:pt-10 lg:pb-20">
			<div class="space-y-16 lg:space-y-24">
				{projects.map((project, i) => (
					<article class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
						<a
							href="/portfolio"
							class:list={[
								'flex h-[274px] w-[453px] max-w-full items-center justify-center overflow-hidden rounded-xl border border-line',
								i % 2 === 1 && 'mx-auto lg:order-2',
							]}
						>
							<Image src={projectImg} alt={`${project.title} thumbnail`} class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]" />
						</a>
						<div class:list={[i % 2 === 1 && 'lg:order-1']}>
							<div class="flex flex-col gap-0.5 text-xs text-muted">
								<span>{project.date}</span>
								{project.company && <span>{project.company}</span>}
							</div>
							<h3 class="mt-2 text-2xl sm:text-3xl">{project.title}</h3>
							<p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">{project.description}</p>
							<div class="mt-4 flex flex-wrap gap-2">
								{project.tags.map((tag) => (
									<span class="rounded border border-accent-muted/40 px-2 py-1 text-[11px] text-accent-muted">{tag}</span>
								))}
							</div>
							<a href="/portfolio" class="group mt-6 inline-flex items-center gap-2 text-sm font-semibold">
								View Project
								<span class="transition-transform group-hover:translate-x-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
							</a>
						</div>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>
