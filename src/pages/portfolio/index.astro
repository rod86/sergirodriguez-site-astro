---
import Layout from "@layouts/Layout.astro";
import { Image } from 'astro:assets';
import {getProjectsList} from "@lib/projects/astroCollection.ts";
import {Icon} from "astro-icon/components";

const projects = await getProjectsList();
---

<Layout title="Projects" description="Selected projects by Sergi Rodriguez, Full Stack Developer.">
    <div class="w-fit mx-auto md:w-auto lg:mx-0">
        <h1 class="mb-14">Projects</h1>
        <section>
            <div class="space-y-16 lg:space-y-24">
                {projects.map((project, i) => (
                    <article class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
                        <a
                            href={`/portfolio/${project.id}`}
                            class:list={[
                                'flex w-90 h-54.5 max-w-full items-center justify-center overflow-hidden rounded-xl border border-stroke lg:w-113.25 lg:h-68.5',
                                i % 2 === 1 && 'md:order-2',
                            ]}
                        >
                            <Image src={project.image!} alt={`${project.title} thumbnail`} class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]" />
                        </a>
                        <div class:list={['lg:max-w-md', i % 2 === 1 && 'lg:order-1']}>
                            <div class="flex flex-col gap-0.5 text-xs text-muted">
                                <span>
                                    {project.date}
                                </span>
                                {project.company && `Working at ${project.company}`}
                            </div>
                            <h3 class="mt-2 text-2xl md:text-3xl">{project.title}</h3>
                            <p class="mt-3 max-w-md text-sm leading-relaxed text-muted">
                                {project.shortDescription}
                            </p>
                            <div class="mt-4 badge-list">
                                {project.tags.map((tag) => (
                                    <span class="badge">{tag}</span>
                                ))}
                            </div>
                            <a href={`/portfolio/${project.id}`} class="group mt-6 flex items-center w-fit mx-auto md:mr-0 gap-2 font-semibold md:text-sm">
                                View Project
                                <span class="transition-transform group-hover:translate-x-1">
                                    <Icon name="lucide:arrow-right" class="h-4 w-4" />
                                </span>
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </div>
</Layout>
