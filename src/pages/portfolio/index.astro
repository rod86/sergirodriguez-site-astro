---
import Layout from "@layouts/Layout.astro";
import { Image } from 'astro:assets';
import { projectsContentProvider } from "@lib/projects";
import {Icon} from "astro-icon/components";
import BadgeList from "@components/common/BadgeList.astro";

const projects = await projectsContentProvider.getProjects();
---

<Layout title="Portfolio" description="Selected projects by Sergi Rodriguez, Full Stack Developer.">
    <div class="w-fit mx-auto md:w-auto lg:mx-0">
        <h1 class="mb-14">Portfolio</h1>
        <section>
            <div class="space-y-16 lg:space-y-24">
                {projects.map((project, i) => (
                    <article class="grid grid-cols-1 items-center gap-8 md:grid-cols-2 md:gap-12">
                        <a
                            href={`/portfolio/${project.id}`}
                            class:list={[
                                'flex w-90 h-54.5 max-w-full items-center justify-center overflow-hidden rounded-xl border border-stroke lg:w-113.25 lg:h-68.5',
                                i % 2 === 1 && 'md:order-2',
                            ]}
                        >
                            {(project.image && project.image.image) && (
                                <Image src={project.image!.image} alt={project.title} class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]" />
                            )}
                        </a>
                        <div class:list={['lg:max-w-md', i % 2 === 1 && 'lg:order-1']}>
                            <div class="flex flex-col gap-0.5 mb-2 text-xs text-muted">
                                <span>
                                    {project.date}
                                </span>
                                {project.company && `Working at ${project.company}`}
                            </div>
                            <h3 class="mb-3 text-2xl md:text-3xl">{project.title}</h3>
                            <p class="mb-4 max-w-md text-sm leading-relaxed text-muted">
                                {project.shortDescription}
                            </p>
                            <BadgeList list={project.tags} />
                            <a href={`/portfolio/${project.id}`} class="link-arrow-right mt-6">
                                View Project
                                <Icon name="lucide:arrow-right" class="link-arrow-icon" />
                            </a>
                        </div>
                    </article>
                ))}
            </div>
        </section>
    </div>
</Layout>
