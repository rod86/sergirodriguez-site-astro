---
import Layout from "@layouts/Layout.astro";
import { Image } from 'astro:assets';
import {getProjectsList} from "@lib/projects/astroCollection.ts";

const projects = await getProjectsList();
---

<Layout title="Projects" description="Selected projects by Sergi Rodriguez, Full Stack Developer.">
	<!-- ===== PAGE HEADER ===== -->
	<section>
	    <div class="page-container pt-10 pb-4 lg:pt-14 lg:pb-6">
	        <h1>Projects</h1>
	    </div>
	</section>

	<!-- ===== FEATURE ROWS ===== -->
	<section>
	    <div class="page-container pt-6 pb-16 lg:pt-10 lg:pb-20">
	        <div class="space-y-16 lg:space-y-24">
	            {projects.map((project, i) => (
	                <article class="grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-12">
	                    <a
	                        href="/portfolio"
	                        class:list={[
	                            'flex h-[274px] w-[453px] max-w-full items-center justify-center overflow-hidden rounded-xl border border-stroke',
	                            i % 2 === 1 && 'mx-auto lg:order-2',
	                        ]}
	                    >
	                        <Image src={project.image!} alt={`${project.title} thumbnail`} class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.03]" />
	                    </a>
	                    <div class:list={[i % 2 === 1 && 'lg:order-1']}>
	                        <div class="flex flex-col gap-0.5 text-xs text-muted">
	                            <span>
	                                {project.date}
	                            </span>
	                            {project.company && `Working at ${project.company}`}
	                        </div>
	                        <h3 class="mt-2 text-2xl sm:text-3xl">{project.title}</h3>
	                        <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
	                            {project.shortDescription}
	                        </p>
	                        <div class="mt-4 badge-list">
	                            {project.tags.map((tag) => (
	                                <span class="badge">{tag}</span>
	                            ))}
	                        </div>
	                        <a href={`/portfolio/${project.id}`} class="group mt-6 inline-flex items-center gap-2 text-sm font-semibold">
								View Project
	                            <span class="transition-transform group-hover:translate-x-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
	                        </a>
	                    </div>
	                </article>
	            ))}
	        </div>
	    </div>
	</section>
</Layout>
