---
import Layout from '@layouts/Layout.astro';
import config from "@config";
---

<Layout title="Privacy Policy" description={`Privacy policy for ${config.siteDomain}`}>
    <section>
        <h1>Privacy Policy</h1>
        <div class="mt-10 space-y-8 text-[15px] leading-relaxed text-muted text-content">
            <div>
                <h2>Data collection</h2>
                <p class="mt-2">
                    Any personal information you provide to us including and similar to your name, address, telephone number and e-mail address will not be released, sold, or rented to any entities or individuals outside of <i>{config.siteDomain}</i>.
                </p>
            </div>
            <div>
                <h2>Portfolio</h2>
                <p class="mt-2">
                    All the work done in companies belongs to the respective companies and their clients.
                </p>
            </div>
            <div>
                <h2>External Sites</h2>
                <p class="mt-2">
                    <i>{config.siteDomain}</i> is not responsible for the content of external internet sites. You are advised to read the privacy policy of external sites before disclosing any personal information.
                </p>
            </div>
            <div>
                <h2>Cookies</h2>
                <p class="mt-2">
                    A "cookie" is a small data text file that is placed in your browser and allows <i>{config.siteDomain}</i> to recognize you each time you visit this site(customisation etc). Cookies themselves do not contain any personal information, and <i>{config.siteDomain}</i> does not use cookies to collect personal information. Cookies may also be used by 3rd party content providers such as newsfeeds.
                </p>
            </div>
            <div>
                <h2>Contact Form</h2>
                <p class="mt-2">
                    Information submitted through the contact form (name, email, and message) is used solely to respond to your inquiry and is retained only as long as needed for that purpose, after which it is deleted.
                </p>
            </div>
            <p>
                For any other information email <a href="/contact">webmaster</a>
            </p>
        </div>
    </section>
</Layout>
